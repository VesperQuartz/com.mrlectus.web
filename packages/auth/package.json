{
  "name": "@repo/auth",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./lib": "./dist/lib/index.mjs",
    "./lib/auth": "./dist/lib/auth.mjs",
    "./lib/permission": "./dist/lib/permission.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "lint": "vp check --fix",
    "auth:generate": "pnpm dlx auth@latest generate --output ../storage/src/schema/auth.schema.ts --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@repo/shared": "workspace:*",
    "@repo/storage": "workspace:*",
    "better-auth": "^1.7.7",
    "better-result": "^3.0.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest"
  }
}
